# Mock is the default and NEVER sends requests to Meta.
BUDDY_MODE=mock
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_API_BASE_URL=https://api.meta.ai/v1
META_TIMEOUT_SECONDS=25
META_ALLOW_PAID_REQUESTS=false
BUDDY_HISTORY_PAIRS=10
BUDDY_MAX_SESSIONS=100
BUDDY_SESSION_TTL_SECONDS=3600
CHESS_CORP_PORT=8080

# Owner inspector login; generate a random token (at least 32 characters).
ADMIN_TOKEN=

# Independent Director gate: mock by default, even if Buddy uses Meta.
DIRECTOR_MODE=mock
DIRECTOR_ALLOW_PAID_REQUESTS=false

# Living AI World: independent consent and bounded shared planning
WORLD_AI_MODE=mock
WORLD_AI_ALLOW_PAID_REQUESTS=false
WORLD_AI_SESSION_LIMIT=3
WORLD_AI_GLOBAL_LIMIT=3
WORLD_AI_MIN_INTERVAL_SECONDS=30
WORLD_AI_MAX_OUTPUT_TOKENS=1800
WORLD_AI_TOKEN_BUDGET=50000

# Optional durable World budget. Docker path below; empty keeps the legacy RAM budget.
WORLD_AI_LEDGER_PATH=

# Owner-only Meta assets: fixed registry, one paid attempt per asset; no startup generation.
ASSET_AI_MODE=mock
ASSET_AI_ALLOW_PAID_REQUESTS=false
ASSET_AI_GLOBAL_LIMIT=1
ASSET_AI_TIMEOUT_SECONDS=120

# Final demo uses a separate local .env: World meta, session limit 6, global 12,
# token budget 150000, output 2400, cooldown 30, persistent ledger in assets/generated.
# Defaults above remain mock. Cached Meta images do not require paid generation enabled.

# Hard cap for fresh session job generations; persistent usage is never reset.
SESSION_JOBS_GLOBAL_LIMIT=50
