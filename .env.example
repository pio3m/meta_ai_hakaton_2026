# Mock is the default and NEVER sends requests to Meta.
BUDDY_MODE=mock
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_API_BASE_URL=https://api.meta.ai/v1
META_TIMEOUT_SECONDS=25
META_ALLOW_PAID_REQUESTS=false
BUDDY_HISTORY_PAIRS=10
BUDDY_MAX_SESSIONS=100
BUDDY_SESSION_TTL_SECONDS=3600
CHESS_CORP_PORT=8080
